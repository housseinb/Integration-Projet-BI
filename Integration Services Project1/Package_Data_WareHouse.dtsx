                  description="Commande SQL à exécuter."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT        dbo.Produit_SA.Code AS ProduitCode, dbo.Produit_SA.Nom AS Produit, dbo.Familles_SA.Nom AS Famille, dbo.Familles_SA.Code AS FamilleCode, dbo.SousFamille_SA.Code AS SousFamilleCode, 
                         dbo.SousFamille_SA.Nom AS SousFamille
