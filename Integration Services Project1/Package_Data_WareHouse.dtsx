                  dataType="System.String"
                  description="Commande SQL à exécuter."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">UPDATE [dbo].[DimProduit]
   SET 
      [Produit] = ?
      ,[SousFamilleCode] = ?
      ,[SousFamille] = ?
      ,[FamilleCode] = ?
      ,[Famille] = ?
 WHERE [ProduitCode] = ?;</property>
