                <property
                  dataType="System.String"
                  description="Commande SQL à exécuter."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT        dbo.Produit_SA.Code AS ProduitCode, dbo.Produit_SA.Nom AS Produit, dbo.SousFamille_SA.Code AS SousFamilleCode, dbo.SousFamille_SA.Nom AS SousFamille, dbo.Familles_SA.Code AS FamilleCode, 
                         dbo.Familles_SA.Nom AS Famille
FROM            dbo.Familles_SA, dbo.SousFamille_SA, dbo.Produit_SA
WHERE        dbo.Familles_SA.Famille_ID = dbo.SousFamille_SA.Famille_ID AND dbo.SousFamille_SA.SousFamille_ID = dbo.Produit_SA.SousFamille_ID</property>
